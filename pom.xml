    <packaging>pom</packaging>

    <name>polaris</name>
    <description>Polaris is a multiple tenant management system</description>
    <url>https://polaris.xsdq.xyz/</url>

    <modules>
        <module>account</module>
        <module>repair</module>
        <module>renovate</module>
