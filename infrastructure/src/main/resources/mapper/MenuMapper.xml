<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsdq.polaris.account.impl.dao.MenuDao">

    <resultMap id="MenuMapping" type="com.xsdq.polaris.account.impl.domain.po.MenuPO">
        <id column="id" property="id" jdbcType="BIGINT" />
        <result column="parent_id" property="parentId" jdbcType="BIGINT" />
        <result column="name" property="name" jdbcType="VARBINARY" />
        <result column="url" property="url" jdbcType="VARCHAR" />
        <result column="method" property="method" jdbcType="VARCHAR" />
        <result column="path" property="path" jdbcType="VARCHAR" />
        <result column="component" property="component" jdbcType="VARCHAR" />
        <result column="redirect" property="redirect" jdbcType="VARCHAR" />
        <result column="type" property="type" jdbcType="TINYINT" />
        <result column="order" property="order" jdbcType="INTEGER" />
        <result column="status" property="status" jdbcType="TINYINT" />
        <result column="permission" property="permission" jdbcType="VARCHAR" />
        <result column="icon_path" property="iconPath" jdbcType="VARCHAR" />
        <result column="title" property="title" jdbcType="VARCHAR" />
        <result column="cacheable" property="cacheable" jdbcType="TINYINT" />
        <result column="hidden" property="hidden" jdbcType="TINYINT" />
        <result column="hidden_header" property="hiddenHeader" jdbcType="TINYINT" />
        <result column="hidden_children" property="hiddenChildren" jdbcType="TINYINT" />
        <result column="target" property="target" jdbcType="VARCHAR" />
        <result column="remark" property="remark" jdbcType="VARCHAR" />
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="QueryFullColumn">
        m.id, m.parent_id, m.name, m.url, m.method, m.path, m.component, m.redirect, m.type, m.order, m.status,
        m.permission, m.icon_path, m.title, m.cacheable, m.hidden, m.hidden_header, m.hidden_children, m.target, m.remark,
        m.create_time, m.update_time
    </sql>

	<select id="findMenusByRoleId" resultMap="MenuMapping">
        select <include refid="QueryFullColumn" />
        from menus m
        inner join role_menu_relations rm on m.id = rm.menu_id
        where rm.role_id in
        <foreach collection="list" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

</mapper>
