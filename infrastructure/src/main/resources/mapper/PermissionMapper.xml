<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsdq.polaris.infrastructure.mapper.PermissionMapper">

    <resultMap id="PermissionPOMapping" type="com.xsdq.polaris.infrastructure.persistence.PermissionPO">
        <id column="id" property="id" jdbcType="BIGINT" />
        <result column="code" property="code" jdbcType="VARCHAR" />
        <result column="name" property="name" jdbcType="VARBINARY" />
        <result column="status" property="status" jdbcType="TINYINT" />
        <result column="description" property="description" jdbcType="VARBINARY" />
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="PermissionPOFullColumns">
        id, code, name, status, description, create_time, update_time
    </sql>

	<select id="selectByRoleId" resultMap="PermissionPOMapping">
        select <include refid="PermissionPOFullColumns" />
        from permissions p
        inner join role_permission_relations rp on p.id = rp.permission_id
        where rp.role_id = #{roleId}
    </select>

</mapper>
